# Phase 7 only. Phases 1-6 need no API key.
#
# Copy to .env and fill in, then:  set -a && source .env && set +a
# .env is gitignored. Never commit a real key.
# Pick whichever matches dataset_generation.provider in configs/default.yaml
GEMINI_API_KEY=
# DEEPSEEK_API_KEY=         # provider: openai_compatible
# LLM_API_KEY=              # generic OpenAI-compatible key
# OPENAI_API_KEY=           # also accepted as a fallback

# Optional overrides
# GOOGLE_API_KEY=            # accepted as a fallback for GEMINI_API_KEY
# OPENAI_BASE_URL=           # unused by this pipeline; Gemini only

# Phase 4 dependency location, if scripts/setup_deps.sh relocated it because the
# repo path contained whitespace. Normally auto-detected from .tools_locator.json.
# CODEBOOK_TOOLS_DIR=/home/you/.cache/codebook-pipeline/tools